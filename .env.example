# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/universe_identity?sslmode=require"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Email (Brevo)
BREVO_API_KEY="xkeysib-xxx"
SENDER_EMAIL="noreply@universelabs.tech"
SENDER_NAME="UniVerse Identity"

# Application
NEXT_PUBLIC_APP_URL="https://universelabs.tech"
NEXT_PUBLIC_APP_NAME="UniVerse Identity"

# JWT Keys (RS256)
# Generate using: npm run generate:keys
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour public key here\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://universelabs.tech"
JWT_AUDIENCE="https://universelabs.tech"

# Session
SESSION_SECRET="your-random-session-secret-min-32-chars"

# Security
CSRF_SECRET="your-random-csrf-secret-min-32-chars"

# Optional: Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
