# This is a sample .env.local file for local development
# Copy this to .env.local and fill in your actual values

# Database (Neon Postgres) - Get from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/universe_identity?sslmode=require"

# Redis (Upstash) - Get from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Email (Brevo) - Get from https://app.brevo.com
BREVO_API_KEY="xkeysib-your-api-key-here"
SENDER_EMAIL="noreply@universelabs.tech"
SENDER_NAME="UniVerse Identity"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="UniVerse Identity"

# JWT Keys - Generate with: npm run generate:keys
# Copy the output from that command
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour public key here\n-----END PUBLIC KEY-----"
JWT_ISSUER="http://localhost:3000"
JWT_AUDIENCE="http://localhost:3000"

# Session & Security Secrets
# Generate with: openssl rand -hex 32
SESSION_SECRET="generate-a-random-32-character-secret-here"
CSRF_SECRET="generate-another-random-32-character-secret-here"

# Optional: Cloudflare R2 (for future file storage)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
